# Vaelor — Template de variaveis (.env.example)
#
# Para usar:
#   1. Copie este arquivo para .env: cp .env.example .env
#   2. Substitua as senhas <GERAR-SENHA-FORTE> por senhas reais
#   3. Para gerar senha forte: openssl rand -base64 24
#
# IMPORTANTE: o arquivo .env (sem .example) NUNCA vai pro Git (esta no .gitignore).

# ============================================================================
# MariaDB (banco de dados)
# ============================================================================
MYSQL_DATABASE=canary
MYSQL_USER=canary
MYSQL_PASSWORD=<GERAR-SENHA-FORTE>
MYSQL_ROOT_PASSWORD=<GERAR-SENHA-FORTE-DIFERENTE-DA-DE-CIMA>

# ============================================================================
# Servidor (login server e canary)
# ============================================================================
SERVER_NAME=Vaelor
SERVER_IP=funnyotserv.com.br
SERVER_PORT=7172
SERVER_LOCATION=BRA
