FROM php:8.2-apache

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    libzip-dev libpng-dev libjpeg-dev libfreetype6-dev libicu-dev \
    libxml2-dev libonig-dev unzip \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        mysqli pdo pdo_mysql gd zip intl mbstring xml \
    && rm -rf /var/lib/apt/lists/*

RUN a2enmod rewrite headers

RUN { \
    echo 'memory_limit = 256M'; \
    echo 'post_max_size = 32M'; \
    echo 'upload_max_filesize = 32M'; \
    echo 'max_execution_time = 60'; \
    echo 'date.timezone = America/Sao_Paulo'; \
} > /usr/local/etc/php/conf.d/myaac.ini

RUN { \
    echo '<Directory /var/www/html>'; \
    echo '  AllowOverride All'; \
    echo '  Require all granted'; \
    echo '</Directory>'; \
} > /etc/apache2/conf-available/myaac.conf \
    && a2enconf myaac

COPY aac/ /var/www/html/

# Permissoes para cache (que o myAAC precisa escrever)
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html \
    && mkdir -p /var/www/html/system/cache/twig \
    && chmod -R 777 /var/www/html/system/cache

# Entrypoint que gera config.lua dinamicamente das env vars
COPY aac/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 80
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
