# Dockerfile do myAAC (Automatic Account Creator) para o Vaelor
FROM php:8.2-apache

ARG DEBIAN_FRONTEND=noninteractive

# Instala extensoes PHP que o myAAC precisa
RUN apt-get update && apt-get install -y --no-install-recommends \
    libzip-dev libpng-dev libjpeg-dev libfreetype6-dev libicu-dev \
    libxml2-dev libonig-dev unzip \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        mysqli pdo pdo_mysql gd zip intl mbstring xml \
    && rm -rf /var/lib/apt/lists/*

# Habilitar mod_rewrite (myAAC usa URL rewriting)
RUN a2enmod rewrite headers

# Configurar PHP para producao
RUN { \
    echo 'memory_limit = 256M'; \
    echo 'post_max_size = 32M'; \
    echo 'upload_max_filesize = 32M'; \
    echo 'max_execution_time = 60'; \
    echo 'date.timezone = America/Sao_Paulo'; \
} > /usr/local/etc/php/conf.d/myaac.ini

# Permitir .htaccess override
RUN { \
    echo '<Directory /var/www/html>'; \
    echo '  AllowOverride All'; \
    echo '  Require all granted'; \
    echo '</Directory>'; \
} > /etc/apache2/conf-available/myaac.conf \
    && a2enconf myaac

# Copiar arquivos do myAAC
COPY aac/ /var/www/html/

# Permissoes
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html

EXPOSE 80

# Apache vai rodar como entrypoint default da imagem php:8.2-apache
