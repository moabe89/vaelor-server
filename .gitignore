# Vaelor — Raiz do Servidor

# Pastas Pesadas (NÃO enviar para a VPS / GitHub)
cliente_4.0/
cliente_1524/
vcpkg/
Outros docs/
*.zip
*.rar
*.dmg
*.app
.DS_Store

# Ignorar pastas de compilação dentro do servidor Canary
canary/build/
canary/.vs/
canary/out/
canary/vcproj/
canary/*.sln
canary/*.vcxproj
canary/*.user
canary/canary
canary/canary.old

# Binários dentro do Canary (compilados localmente, não vão para VPS)
canary/*.exe
canary/*.dll
canary/vcpkg_installed/
canary/Debug/
canary/.git/
canary/.github/

# Ignorar arquivos de log
*.log
canary/*.log

# Banco de dados (dump completo do MariaDB NÃO vai pro repo — exportado separadamente)
*.sql
# EXCEÇÃO: schema base do canary (necessário pelo Dockerfile e docker-compose)
!canary/schema.sql

# Arquivos de Sistema e IDE
.vscode/
.idea/
.claude/
.gemini/
memory/
.mcp.json

# Credenciais e Senhas (Segurança)
.env
.env.local
*.key
*.pem
# EXCEÇÃO: chave RSA do canary (necessária para o servidor iniciar — repo é PRIVADO)
!canary/key.pem

# Mapas .otbm (muito grandes para o GitHub, Canary baixa automaticamente do release)
canary/data-otservbr-global/world/*.otbm

# Script do Inno Setup (não precisa ir pro server)
*.iss
