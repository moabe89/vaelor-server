canary/.github/

# Ignorar arquivos de log
*.log
canary/*.log

# Banco de dados (dump completo do MariaDB NÃO vai pro repo — exportado separadamente)
*.sql
# EXCEÇÃO: schema base do canary (necessário pelo Dockerfile e docker-compose)
!canary/schema.sql

# Arquivos de Sistema e IDE
.vscode/
.idea/
.claude/
.gemini/
memory/
.mcp.json

# Credenciais e Senhas (Segurança)
.env
.env.local
*.key
*.pem
# EXCEÇÃO: chave RSA do canary (necessária para o servidor iniciar — repo é PRIVADO)
!canary/key.pem

# Mapas .otbm (muito grandes para o GitHub, Canary baixa automaticamente do release)
canary/data-otservbr-global/world/*.otbm

# Script do Inno Setup (não precisa ir pro server)
*.iss

# myAAC - excluir cache, node_modules e logs (geram em runtime)
